{
  "name": "pong-arcade",
  "version": "3.0.0",
  "private": true,
  "description": "Pong Arcade 3D — duelo de robots en una arena de neón. Motor determinista con arquitectura hexagonal y render 3D en Three.js.",
  "type": "module",
  "license": "MIT",
  "author": "NainDev",
  "homepage": "https://pong.naindev.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nain9Dev/pong-arcade-js.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy:check": "node scripts/publish.mjs check",
    "deploy:pr": "node scripts/publish.mjs pr",
    "deploy:merge": "node scripts/publish.mjs merge --yes",
    "deploy:verify": "node scripts/publish.mjs verify",
    "release": "node scripts/publish.mjs release --yes"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
